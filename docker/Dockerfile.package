# syntax=docker/dockerfile:1.7
# ============================================================================
# Универсальный шаблон сборки ROS2-пакета с CUDA
# Поддерживает ROS2 Humble и Jazzy через ARG ROS_DISTRO
# ============================================================================

ARG BASE_IMAGE
ARG CUDA_ARCHITECTURES
ARG REPO_URL
ARG BRANCH=main
ARG PACKAGE_NAME
ARG ROS_DISTRO=humble

FROM ${BASE_IMAGE} AS builder

ARG CUDA_ARCHITECTURES
ARG REPO_URL
ARG BRANCH
ARG PACKAGE_NAME
ARG ROS_DISTRO

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES}
ENV ROS_DISTRO=${ROS_DISTRO}
ENV MAKEFLAGS="-j$(nproc)"

# ⚠️ КРИТИЧНО: обновляем CMake до 3.28+
# Ubuntu 22.04 (x86, agx) идёт с CMake 3.22, который НЕ пробрасывает
# CMAKE_CUDA_STANDARD=17 в nvcc. nvcc остаётся на C++14 и падает на
# std::is_same_v / std::optional / std::variant в rclcpp-заголовках.
# Ubuntu 24.04 (nano) уже имеет CMake 3.28 — там сборка проходила.
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3-pip && \
    pip3 install --no-cache-dir --break-system-packages "cmake>=3.28,<3.30" && \
    rm -rf /var/lib/apt/lists/* && \
    which cmake && cmake --version

WORKDIR /workspace/src

# ---------------------------------------------------------------------------
# 1. Клонирование исходников пакета
# ---------------------------------------------------------------------------
RUN git clone --depth 1 --branch "${BRANCH}" "${REPO_URL}" "${PACKAGE_NAME}" && \
    cd "${PACKAGE_NAME}" && \
    git submodule update --init --recursive --depth 1 || \
    (echo "⚠️ submodules not found, continuing" && true)

# ---------------------------------------------------------------------------
# 2. Клонирование livox_ros_driver2
# ---------------------------------------------------------------------------
RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git \
    livox_ros_driver2 || true

# ---------------------------------------------------------------------------
# 3. Установка зависимостей через rosdep
# ---------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    rosdep install --from-paths . --ignore-src -y \
      --skip-keys=livox_ros_driver2,pcl_ros || true

# ---------------------------------------------------------------------------
# 4. Сборка пакета с CUDA
# ---------------------------------------------------------------------------
WORKDIR /workspace
RUN --mount=type=cache,target=/workspace/build \
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build \
      --packages-select ${PACKAGE_NAME} \
      --build-base /workspace/build \
      --install-base /workspace/install \
      --cmake-args \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_STANDARD=17 \
        -DCMAKE_CXX_STANDARD_REQUIRED=ON \
        -DCMAKE_CXX_EXTENSIONS=OFF \
        -DCMAKE_CUDA_STANDARD=17 \
        -DCMAKE_CUDA_STANDARD_REQUIRED=ON \
        -DCMAKE_CUDA_EXTENSIONS=OFF \
        -DCMAKE_CUDA_FLAGS="--expt-relaxed-constexpr --expt-extended-lambda" \
        -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} \
        -DFASTLIO_USE_CUDA=ON \
        -DBUILD_TESTING=OFF

# Проверка CUDA
RUN nvcc --version

# Проверка артефактов
RUN test -d /workspace/install && \
    test -f /workspace/install/setup.bash && \
    echo "✅ install artifacts present" || \
    (echo "❌ install artifacts missing" && ls -la /workspace/ && exit 1)

# ---------------------------------------------------------------------------
# 5. Runtime-образ
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS runtime

# ИСПРАВЛЕНО: ARG без дефолта — наследует значение из build-arg
ARG ROS_DISTRO

SHELL ["/bin/bash", "-c"]

ENV ROS_DISTRO=${ROS_DISTRO}
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /opt/ros_ws

COPY --from=builder /workspace/install /workspace/install

# Подтверждение наличия CUDA (пункт 4 ТЗ)
RUN nvcc --version && echo "CUDA toolkit present"

# Автозагрузка ROS2 окружения
RUN echo 'source /opt/ros/${ROS_DISTRO}/setup.bash' >> /etc/bash.bashrc && \
    echo 'source /workspace/install/setup.bash' >> /etc/bash.bashrc

ENV PATH="/workspace/install/bin:/opt/ros/${ROS_DISTRO}/bin:${PATH}" \
    LD_LIBRARY_PATH="/workspace/install/lib:/opt/ros/${ROS_DISTRO}/lib:${LD_LIBRARY_PATH}"

CMD ["/bin/bash"]