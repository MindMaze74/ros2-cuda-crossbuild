# Универсальный шаблон сборки ROS2-пакета с CUDA.
# Поддерживает Humble и Jazzy через аргумент ROS_DISTRO.

ARG BASE_IMAGE
ARG CUDA_ARCHITECTURES
ARG REPO_URL
ARG BRANCH=main
ARG PACKAGE_NAME
ARG ROS_DISTRO=humble
ARG CMAKE_ARGS=""

# ============================================================================
# STAGE 1: Builder
# ============================================================================
FROM ${BASE_IMAGE} AS builder

ARG CUDA_ARCHITECTURES
ARG REPO_URL
ARG BRANCH
ARG PACKAGE_NAME
ARG ROS_DISTRO
ARG CMAKE_ARGS

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}
ENV MAKEFLAGS="-j$(nproc)"

# Ставим CMake 3.28+ из репозитория Kitware.
# CMake 3.22 из Ubuntu 22.04 не пробрасывает CMAKE_CUDA_STANDARD в nvcc,
# из-за чего nvcc компилирует .cu с C++14 и падает на заголовках ROS2.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        wget gpg ca-certificates lsb-release && \
    wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc 2>/dev/null | \
        gpg --dearmor -o /usr/share/keyrings/kitware-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] \
        https://apt.kitware.com/ubuntu/ $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/kitware.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends cmake && \
    rm -rf /var/lib/apt/lists/* && \
    cmake --version

WORKDIR /workspace/src

# Клонируем пакет и submodules (ikd-Tree нужен для FAST-LIO)
RUN git clone --depth 1 --branch "${BRANCH}" "${REPO_URL}" "${PACKAGE_NAME}" && \
    cd "${PACKAGE_NAME}" && \
    git submodule update --init --recursive --depth 1 || \
    (echo "submodules not found, continuing" && true)

# Опциональная зависимость FAST-LIO — если не склонируется, продолжаем
RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git \
        livox_ros_driver2 || true

# Устанавливаем зависимости через rosdep
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    rosdep install --from-paths . --ignore-src -y \
        --skip-keys=livox_ros_driver2,pcl_ros || true

# Собираем пакет. CMAKE_CUDA_STANDARD=17 работает только с CMake 3.28+.
# -std=c++17 в CMAKE_CUDA_FLAGS не передаём, чтобы не конфликтовал.
WORKDIR /workspace
RUN --mount=type=cache,target=/workspace/build \
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build \
        --packages-select ${PACKAGE_NAME} \
        --build-base /workspace/build \
        --install-base /workspace/install \
        --cmake-args \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_CXX_STANDARD=17 \
            -DCMAKE_CXX_STANDARD_REQUIRED=ON \
            -DCMAKE_CXX_EXTENSIONS=OFF \
            -DCMAKE_CUDA_STANDARD=17 \
            -DCMAKE_CUDA_STANDARD_REQUIRED=ON \
            -DCMAKE_CUDA_EXTENSIONS=OFF \
            -DCMAKE_CUDA_FLAGS="--expt-relaxed-constexpr --expt-extended-lambda" \
            -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} \
            ${CMAKE_ARGS}

# Проверки
RUN nvcc --version
RUN test -d /workspace/install && \
    test -f /workspace/install/setup.bash && \
    echo "install artifacts present"

# ============================================================================
# STAGE 2: Runtime
# ============================================================================
FROM ${BASE_IMAGE} AS runtime

ARG ROS_DISTRO
SHELL ["/bin/bash", "-c"]

ENV ROS_DISTRO=${ROS_DISTRO}
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /opt/ros_ws

# Копируем собранные артефакты в стандартный путь
COPY --from=builder /workspace/install /opt/ros_ws/install

# Проверяем CUDA в финальном образе
RUN nvcc --version && echo "CUDA toolkit present"

# Автозагрузка окружения ROS2
RUN echo 'source /opt/ros/${ROS_DISTRO}/setup.bash' >> /etc/bash.bashrc && \
    echo 'source /opt/ros_ws/install/setup.bash' >> /etc/bash.bashrc

ENV PATH="/opt/ros_ws/install/bin:/opt/ros/${ROS_DISTRO}/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/ros_ws/install/lib:/opt/ros/${ROS_DISTRO}/lib:${LD_LIBRARY_PATH}"

CMD ["/bin/bash"]