# Универсальный шаблон сборки ROS2-пакета с CUDA.
# Поддерживает Humble и Jazzy через аргумент ROS_DISTRO.
#
# Аргументы:
#   BASE_IMAGE           — базовый образ с ROS2 + CUDA (ros2-base-*)
#   CUDA_ARCHITECTURES   — 86 для x86 (Ampere), 87 для Orin
#   REPO_URL             — Git URL собираемого пакета
#   BRANCH               — ветка (по умолчанию main)
#   PACKAGE_NAME         — имя пакета внутри репозитория (для colcon --packages-select)
#   ROS_DISTRO           — humble (Ubuntu 22.04) или jazzy (Ubuntu 24.04)
#   CMAKE_ARGS           — дополнительные флаги CMake

ARG BASE_IMAGE
ARG CUDA_ARCHITECTURES
ARG REPO_URL
ARG BRANCH=main
ARG PACKAGE_NAME
ARG ROS_DISTRO=humble
ARG CMAKE_ARGS=""

# ============================================================================
# STAGE 1: Builder
# ============================================================================
FROM ${BASE_IMAGE} AS builder

ARG CUDA_ARCHITECTURES
ARG REPO_URL
ARG BRANCH
ARG PACKAGE_NAME
ARG ROS_DISTRO
ARG CMAKE_ARGS

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}
ENV MAKEFLAGS="-j$(nproc)"

# CMake уже установлен в базовом образе из Kitware APT (см. ADR-0003).
# Проверяем версию, но не переустанавливаем — переустановка через повторный
# download ключа Kitware даёт лишнюю точку отказа (транзиентные сбои
# apt.kitware.com ломают сборку).
RUN cmake --version && \
    cmake --version | grep -qE 'version (3\.2[89]|[4-9])' || \
    (echo "ERROR: base image must have CMake >= 3.28 from Kitware" && exit 1)pt/lists/* && \
    cmake --version

# Python dev-заголовки. Нужны для find_package(PythonLibs REQUIRED)
# в CMakeLists.txt FAST_LIO2_GPU. В базовых образах их нет,
# rosdep их не тянет (не задекларированы в package.xml репозитория).
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-dev \
        libpython3-dev \
        python3-numpy \
    && rm -rf /var/lib/apt/lists/*

# Дополнительные зависимости FAST-LIVO2: Sophus и Vikit (rpg_vikit).
# Ставим только если собираем fast_livo — для fast_lio они не нужны.
#
# Sophus — 1.22.10, совместим с C++17 и Eigen 3.4.
# CMAKE_POLICY_VERSION_MINIMUM=3.5 — обход ошибки CMake 4.x на старом
# cmake_minimum_required(VERSION 3.0) внутри Sophus.
#
# Vikit — форк HKU MARS: https://github.com/xuankuzcr/rpg_vikit
RUN if [ "$PACKAGE_NAME" = "fast_livo" ]; then \
      set -eux; \
      apt-get update && apt-get install -y --no-install-recommends \
        libeigen3-dev \
        libopencv-dev \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-tf2-eigen \
        ros-${ROS_DISTRO}-pcl-ros \
        ros-${ROS_DISTRO}-pcl-conversions \
      && rm -rf /var/lib/apt/lists/*; \
      \
      git clone --depth 1 --branch 1.22.10 https://github.com/strasdat/Sophus.git /tmp/Sophus; \
      cd /tmp/Sophus && mkdir build && cd build \
        && cmake .. \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
            -DBUILD_SOPHUS_TESTS=OFF \
            -DBUILD_SOPHUS_EXAMPLES=OFF \
        && make -j$(nproc) install; \
      cd /tmp; \
      rm -rf /tmp/Sophus; \
      \
      git clone --depth 1 https://github.com/xuankuzcr/rpg_vikit.git /tmp/vikit; \
      cd /tmp/vikit/vikit_common && mkdir build && cd build \
        && cmake .. \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        && make -j$(nproc) install; \
      cd /tmp; \
      rm -rf /tmp/vikit; \
      \
      ldconfig; \
    fi

WORKDIR /workspace/src

# Клонируем пакет и submodules (ikd-Tree нужен для FAST-LIO)
RUN git clone --depth 1 --branch "${BRANCH}" "${REPO_URL}" "${PACKAGE_NAME}" && \
    cd "${PACKAGE_NAME}" && \
    git submodule update --init --recursive --depth 1 || \
    (echo "submodules not found, continuing" && true)

# Опциональная зависимость FAST-LIO — если не склонируется, продолжаем
RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git \
        livox_ros_driver2 || true

# Зависимости через rosdep.
# pcl_ros НЕ скипаем — FAST-LIVO2 и FAST-LIO2 его используют,
# без него падает компиляция на #include <pcl_ros/...>.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    rosdep install --from-paths . --ignore-src -y \
        --skip-keys=livox_ros_driver2 || true

# Сборка.
# CMAKE_POLICY_VERSION_MINIMUM=3.5 — обход CMake 4.x на старых
# cmake_minimum_required в CMakeLists.txt пакетов HKU MARS.
WORKDIR /workspace
RUN --mount=type=cache,target=/workspace/build \
    source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build \
        --packages-select ${PACKAGE_NAME} \
        --build-base /workspace/build \
        --install-base /workspace/install \
        --cmake-args \
            -DCMAKE_BUILD_TYPE=Release \
            -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
            -DCMAKE_CXX_STANDARD=17 \
            -DCMAKE_CXX_STANDARD_REQUIRED=ON \
            -DCMAKE_CXX_EXTENSIONS=OFF \
            -DCMAKE_CUDA_STANDARD=17 \
            -DCMAKE_CUDA_STANDARD_REQUIRED=ON \
            -DCMAKE_CUDA_EXTENSIONS=OFF \
            -DCMAKE_CUDA_FLAGS="--expt-relaxed-constexpr --expt-extended-lambda" \
            -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} \
            ${CMAKE_ARGS}

# Проверки
RUN nvcc --version
RUN test -d /workspace/install && \
    test -f /workspace/install/setup.bash && \
    echo "install artifacts present"

# ============================================================================
# STAGE 2: Runtime
# ============================================================================
FROM ${BASE_IMAGE} AS runtime

ARG ROS_DISTRO
SHELL ["/bin/bash", "-c"]

ENV ROS_DISTRO=${ROS_DISTRO}
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /opt/ros_ws

# Копируем собранные артефакты в стандартный путь
COPY --from=builder /workspace/install /opt/ros_ws/install

# CUDA присутствует в базовом образе, но проверим явно.
RUN nvcc --version && echo "CUDA toolkit present"

# Автозагрузка окружения ROS2
RUN echo 'source /opt/ros/${ROS_DISTRO}/setup.bash' >> /etc/bash.bashrc && \
    echo 'source /opt/ros_ws/install/setup.bash' >> /etc/bash.bashrc

ENV PATH="/opt/ros_ws/install/bin:/opt/ros/${ROS_DISTRO}/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/ros_ws/install/lib:/opt/ros/${ROS_DISTRO}/lib:${LD_LIBRARY_PATH}"

CMD ["/bin/bash"]