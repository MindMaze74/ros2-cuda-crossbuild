# docker/Dockerfile.base.x86
FROM nvidia/cuda:12.9.0-devel-ubuntu22.04

# Установка ROS 2 Humble
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    && add-apt-repository universe \
    && curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(source /etc/os-release && echo \$UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -y ros-humble-ros-base

WORKDIR /workspace/src

RUN git clone --depth 1 --branch "main" "https://github.com/ruiqichao/FAST_LIO2_GPU.git" "fast_lio" && \
    cd "fast_lio" && \
    git submodule update --init --recursive --depth 1 || \
    (echo "⚠️ submodules not found, continuing" && true)

RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git livox_ros_driver2 || true

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    source /opt/ros/humble/setup.bash && \
    rosdep install --from-paths . --ignore-src -y --skip-keys=livox_ros_driver2,pcl_ros || true

WORKDIR /workspace

# ИСПРАВЛЕННАЯ СТРОКА СБОРКИ:
# 1. Добавлен /bin/bash -c
# 2. CMAKE_CUDA_ARCHITECTURES установлен в 86 (архитектура для x86 GPU)
RUN --mount=type=cache,target=/workspace/build \
    /bin/bash -c "source /opt/ros/humble/setup.bash && \
    colcon build \
      --packages-select fast_lio \
      --build-base /workspace/build \
      --install-base /workspace/install \
      --cmake-args \
        -DCMAKE_BUILD_TYPE=Release
