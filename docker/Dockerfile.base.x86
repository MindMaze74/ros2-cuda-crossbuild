# syntax=docker/dockerfile:1.7
FROM nvidia/cuda:12.6.3-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV CUDA_ARCHITECTURES="86"

# Системные зависимости + pip
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        curl \
        wget \
        git \
        build-essential \
        cmake \
        pkg-config \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ⚠️ КРИТИЧНО: обновляем CMake до 3.28+ через pip
# CMake 3.22 (из apt Ubuntu 22.04) не умеет пробрасывать CMAKE_CUDA_STANDARD в nvcc.
# Из-за этого nvcc использует C++14 и падает на std::is_same_v / std::optional / std::variant
# в заголовках ROS2 Humble.
RUN pip3 install --no-cache-dir "cmake==3.28.3" && \
    which cmake && cmake --version

# ROS2 Humble + pcl_ros + pcl_conversions
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
       > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-pcl-ros \
        ros-${ROS_DISTRO}-pcl-conversions \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# PCL, Eigen
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        libpcl-dev \
        libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# Livox-SDK2
RUN --mount=type=cache,target=/tmp/livox-build \
    git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 \
    && cd /tmp/Livox-SDK2 \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/Livox-SDK2

RUN rosdep init || true && rosdep update

WORKDIR /workspace
ENV PATH="/opt/ros/${ROS_DISTRO}/bin:${PATH}"

CMD ["/bin/bash"]
