# syntax=docker/dockerfile:1.7
FROM dustynv/ros:humble-desktop-l4t-r36.4.0

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV CUDA_ARCHITECTURES="87"

# Фикс ldconfig для QEMU
RUN if [ -f /sbin/ldconfig ] && [ ! -f /sbin/ldconfig.real ]; then \
        cp /sbin/ldconfig /sbin/ldconfig.real; \
    fi && \
    printf '#!/bin/sh\nexit 0\n' > /sbin/ldconfig && \
    chmod +x /sbin/ldconfig

# Фикс пути к ROS2 setup.bash (dustynv собирает из исходников — setup в /install/)
RUN if [ -f /opt/ros/${ROS_DISTRO}/install/setup.bash ] && [ ! -f /opt/ros/${ROS_DISTRO}/setup.bash ]; then \
        ln -s /opt/ros/${ROS_DISTRO}/install/setup.bash /opt/ros/${ROS_DISTRO}/setup.bash; \
    fi

# Обновление истёкшего GPG-ключа ROS2 + системные зависимости
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update 2>/dev/null || true \
    && apt-get install -y --no-install-recommends wget gnupg2 || true \
    && rm -f /usr/share/keyrings/ros-archive-keyring.gpg \
    && rm -f /etc/apt/trusted.gpg.d/ros*.gpg \
    && apt-key del F42ED6FBAB17C654 2>/dev/null || true \
    && wget -qO- https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
       | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
       > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        software-properties-common \
        curl \
        wget \
        git \
        build-essential \
        cmake \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# PCL, Eigen
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        libpcl-dev \
        libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# Livox-SDK2
RUN --mount=type=cache,target=/tmp/livox-build \
    git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 \
    && cd /tmp/Livox-SDK2 \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j2 \
    && make install \
    && rm -rf /tmp/Livox-SDK2

RUN rosdep init || true && rosdep update

WORKDIR /workspace
ENV PATH="/opt/ros/${ROS_DISTRO}/bin:${PATH}"

CMD ["/bin/bash"]
