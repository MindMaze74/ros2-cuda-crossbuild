# syntax=docker/dockerfile:1.7
# ============================================================================
# AGX Orin — JetPack 6.2.2 (L4T R36.5.0, ядро 5.15.185-tegra)
# ============================================================================
# ПРИМЕЧАНИЕ: официального образа l4t-jetpack:r36.5.0 в NGC пока нет.
# Используем r36.4.0 — последний доступный, совместимый с JetPack 6.2.2
# по ключевым библиотекам CUDA/cuDNN. Для 100% соответствия требуется
# self-hosted Jetson с предустановленным JetPack 6.2.2.
#
# ROS2 Humble + pcl_ros устанавливаются ПОВЕРХ официального L4T — это даёт
# полное соответствие по L4T R36.4.0 и полноценный ROS2-стек.
# ============================================================================

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV CUDA_ARCHITECTURES="87"

# ---------------------------------------------------------------------------
# 1. Workaround QEMU: подменяем ldconfig заглушкой.
#    Под ARM64-эмуляцией dpkg triggers вызывают /sbin/ldconfig, который
#    падает с segfault. Заглушка обходит это.
# ---------------------------------------------------------------------------
RUN if [ -x /sbin/ldconfig ] && [ ! -e /sbin/ldconfig.real ]; then \
        cp /sbin/ldconfig /sbin/ldconfig.real; \
    fi && \
    printf '#!/bin/sh\nexit 0\n' > /sbin/ldconfig && \
    chmod +x /sbin/ldconfig

# ---------------------------------------------------------------------------
# 2. Репозиторий ROS2 Humble
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg2 lsb-release ca-certificates \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# 3. ROS2 Humble + pcl_ros + build-tools + PCL/Eigen
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-pcl-ros \
        ros-${ROS_DISTRO}-pcl-conversions \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
        python3-pip \
        build-essential cmake git wget \
        libpcl-dev libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true && \
    rosdep update --rosdistro ${ROS_DISTRO}

# ---------------------------------------------------------------------------
# 4. Livox-SDK2 (для FAST-LIO2)
# ---------------------------------------------------------------------------
RUN git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 \
    && cd /tmp/Livox-SDK2 \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/Livox-SDK2

# ---------------------------------------------------------------------------
# 5. Восстановить настоящий ldconfig для runtime на реальном Jetson
# ---------------------------------------------------------------------------
RUN if [ -e /sbin/ldconfig.real ]; then \
        mv /sbin/ldconfig.real /sbin/ldconfig && \
        chmod +x /sbin/ldconfig; \
    fi

WORKDIR /workspace
ENV PATH="/opt/ros/${ROS_DISTRO}/bin:${PATH}"

CMD ["/bin/bash"]
