# syntax=docker/dockerfile:1.7
# ============================================================================
# Orin Nano — JetPack 7 (L4T R39.2.1, Ubuntu 24.04)
# ВАРИАНТ B: ROS2 Jazzy
# ============================================================================
# Если тег r39.2.1 недоступен в NGC, проверьте актуальные теги:
#   docker pull nvcr.io/nvidia/l4t-jetpack:r39.2.1
# или используйте dusty-nv/jetson-containers как альтернативу.
# ============================================================================

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# ВАЖНО: Jazzy для Ubuntu 24.04
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy

# Workaround QEMU: ldconfig заглушка
RUN if [ -x /sbin/ldconfig ] && [ ! -e /sbin/ldconfig.real ]; then \
        cp /sbin/ldconfig /sbin/ldconfig.real; \
    fi && \
    printf '#!/bin/sh\nexit 0\n' > /sbin/ldconfig && \
    chmod +x /sbin/ldconfig

# Репозиторий ROS2 Jazzy (Ubuntu 24.04 = noble)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg2 lsb-release ca-certificates software-properties-common \
    && add-apt-repository universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list \
    && rm -rf /var/lib/apt/lists/*

# ROS2 Jazzy + зависимости
# Примечание: имена пакетов в Jazzy могут отличаться от Humble.
# Если пакет недоступен — закомментируйте строку и соберите из исходников.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-pcl-ros \
        ros-${ROS_DISTRO}-pcl-conversions \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
        python3-pip \
        build-essential cmake git wget \
        libpcl-dev libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true && \
    rosdep update --rosdistro ${ROS_DISTRO}

# Livox-SDK2
RUN git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 \
    && cd /tmp/Livox-SDK2 && mkdir build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j$(nproc) && make install \
    && rm -rf /tmp/Livox-SDK2

# Восстановить ldconfig
RUN if [ -e /sbin/ldconfig.real ]; then \
        mv /sbin/ldconfig.real /sbin/ldconfig && chmod +x /sbin/ldconfig; \
    fi

WORKDIR /workspace
ENV PATH="/opt/ros/${ROS_DISTRO}/bin:${PATH}"

CMD ["/bin/bash"]
