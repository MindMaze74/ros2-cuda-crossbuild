# docker/Dockerfile.base.nano
FROM ghcr.io/mindmaze74/ros2-cuda-crossbuild/ros2-base-nano:latest

# Установка зависимостей (если требуется)
# RUN apt-get update && apt-get install -y <дополнительные пакеты>

WORKDIR /workspace/src

# Клонирование репозиториев
RUN git clone --depth 1 --branch "main" "https://github.com/ruiqichao/FAST_LIO2_GPU.git" "fast_lio" && \
    cd "fast_lio" && \
    git submodule update --init --recursive --depth 1 || \
    (echo "⚠️ submodules not found, continuing" && true)

RUN git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git livox_ros_driver2 || true

# Установка зависимостей через rosdep
# Примечание: source здесь не нужен, так как rosdep сам находит пакеты в образе
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rosdep install --from-paths . --ignore-src -y --skip-keys=livox_ros_driver2,pcl_ros || true

WORKDIR /workspace

# ИСПРАВЛЕННАЯ СТРОКА СБОРКИ:
# 1. Добавлен /bin/bash -c для корректной работы source
# 2. CMAKE_CUDA_ARCHITECTURES установлен в 53 (архитектура Jetson Nano)
RUN --mount=type=cache,target=/workspace/build \
    /bin/bash -c "source /opt/ros/humble/setup.bash && \
    colcon build \
      --packages-select fast_lio \
      --build-base /workspace/build \
      --install-base /workspace/install \
      --cmake-args \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_STANDARD=17 \
        -DCMAKE_CXX_STANDARD_REQUIRED=ON \
        -DCMAKE_CXX_EXTENSIONS=OFF \
        -DCMAKE_CUDA_STANDARD=17 \
        -DCMAKE_CUDA_STANDARD_REQUIRED=ON \
        -DCMAKE_CUDA_EXTENSIONS=OFF \
        -DCMAKE_CUDA_FLAGS=\"--expt-relaxed-constexpr --expt-extended-lambda\" \
        -DCMAKE_CUDA_ARCHITECTURES=53 \
        -DFASTLIO_USE_CUDA=ON \
        -DBUILD_TESTING=OFF"

# Копирование результатов сборки (опционально, если образ используется дальше)
# COPY --from=builder /workspace/install /opt/ros_ws/install
